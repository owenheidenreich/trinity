#!/bin/bash
# Test the simple generate endpoints directly - bypasses all frontend complexity

PROXY_URL="${1:-https://vercel-proxy-swart-nine.vercel.app}"

echo "============================================"
echo "  TRINITY SIMPLE GENERATE TEST"
echo "============================================"
echo ""
echo "Target: $PROXY_URL"
echo ""

# Test 1: Health check
echo "1. Health Check..."
health=$(curl -s "$PROXY_URL/health" | python3 -c "import sys,json; d=json.load(sys.stdin); print(f\"Model: {d.get('model','?')}, Status: {d.get('status','?')}\")" 2>/dev/null)
if [ $? -eq 0 ]; then
    echo "   ✅ $health"
else
    echo "   ❌ Health check failed"
    exit 1
fi
echo ""

# Test 2: Simple generate (non-streaming)
echo "2. Simple Generate (non-streaming)..."
echo "   Prompt: 'What is 2+2?'"
response=$(curl -s -X POST "$PROXY_URL/generate/simple" \
    -H "Content-Type: application/json" \
    -d '{"prompt": "What is 2+2? Answer in one word.", "max_length": 20}')

ok=$(echo "$response" | python3 -c "import sys,json; print(json.load(sys.stdin).get('ok', False))" 2>/dev/null)
text=$(echo "$response" | python3 -c "import sys,json; print(json.load(sys.stdin).get('response', 'NO RESPONSE')[:100])" 2>/dev/null)

if [ "$ok" = "True" ]; then
    echo "   ✅ Response: $text"
else
    echo "   ❌ Failed: $response"
fi
echo ""

# Test 3: Simple generate streaming
echo "3. Simple Generate (streaming)..."
echo "   Prompt: 'Say hello'"
echo "   Response: "
curl -s -N -X POST "$PROXY_URL/generate/simple/stream" \
    -H "Content-Type: application/json" \
    -d '{"prompt": "Say hello in exactly 3 words", "max_length": 20}' | \
    while IFS= read -r line; do
        if [[ $line == data:* ]]; then
            token=$(echo "${line:6}" | python3 -c "import sys,json; print(json.load(sys.stdin).get('token',''), end='')" 2>/dev/null)
            echo -n "$token"
        fi
    done
echo ""
echo ""

# Test 4: Compare with complex endpoint
echo "4. Complex Generate (for comparison)..."
echo "   Prompt: 'What is 2+2?'"
response=$(curl -s -X POST "$PROXY_URL/generate" \
    -H "Content-Type: application/json" \
    -d '{"prompt": "What is 2+2? Answer in one word.", "max_length": 20}')

text=$(echo "$response" | python3 -c "import sys,json; print(json.load(sys.stdin).get('response', 'NO RESPONSE')[:100])" 2>/dev/null)
echo "   Response: $text"
echo ""

echo "============================================"
echo "  TEST COMPLETE"
echo "============================================"
echo ""
echo "If simple endpoints work but complex doesn't,"
echo "the issue is in context/prompt building."
echo ""
echo "To deploy these changes:"
echo "  ./scripts/trinity-deploy-production.sh 1"
