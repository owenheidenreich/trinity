[run]
source = .
omit = 
    tests/*
    */__pycache__/*
    */migrations/*
    venv/*
    .venv/*

[report]
exclude_lines =
    pragma: no cover
    def __repr__
    raise NotImplementedError
    if __name__ == .__main__.:
    if TYPE_CHECKING:
    pass

show_missing = true
precision = 2

[html]
directory = htmlcov
