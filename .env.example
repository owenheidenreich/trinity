# Trinity Environment Configuration
# Copy this file to .env and fill in your values
# ================================================

# ============================================
# AKASH BACKEND DEPLOYMENT
# ============================================
# These are set automatically by the Docker container via deploy/docker/Dockerfile
# You only need to configure FILECOIN_API_KEY for archive functionality

# Provider ID shown in UI (set by Akash deployment YAML)
# PROVIDER_ID=trinity-llama70b

# LLM model to use (set by Akash deployment YAML)
# MODEL_NAME=llama3.1:70b

# Ollama backend connection (set by startup.sh)
# OLLAMA_HOST=http://localhost:11434

# Model backend type
# MODEL_BACKEND=ollama

# ============================================
# LIGHTHOUSE / FILECOIN STORAGE (Required for Archives)
# ============================================
# Lighthouse provides IPFS pinning + verified Filecoin storage deals.
# Get your API key from: https://files.lighthouse.storage
#
# Note: FILECOIN_API_KEY is still supported for backward compatibility
#       but LIGHTHOUSE_API_KEY takes precedence.

# Lighthouse API key for IPFS + Filecoin archival
LIGHTHOUSE_API_KEY=your_lighthouse_api_key_here

# Legacy Pinata support (deprecated - use LIGHTHOUSE_API_KEY instead)
# FILECOIN_API_KEY=your_pinata_jwt_token_here

# ============================================
# LOCAL DEVELOPMENT ONLY
# ============================================
# These override production settings when running locally

# Local chat storage directory (default: $HOME/.trinity/chats)
# CHATS_DIR=/path/to/local/chats

# ============================================
# FRONTEND CONFIGURATION
# ============================================
# Frontend is configured via trinity-icp/src/config.js
# No environment variables needed - it auto-detects environment

# Production backend URLs (in trinity-icp/src/config.js):
#   akashUrl: https://api.trinityai.cc
#   canisterId: brqfx-paaaa-aaaao-a3wpa-cai
#
# Local development (auto-detected):
#   localhost:8000

# ============================================
# ICP DEPLOYMENT (DFX)
# ============================================
# Configure via ~/.config/dfx/identity.json

# Canister IDs are stored in trinity-icp/canister_ids.json
# Deploy with: cd trinity-icp && dfx deploy --ic trinity_frontend

# ============================================
# CLOUDFLARE WORKERS
# ============================================
# Edit cloudflare/workers/trinity-ai-proxy.js directly
# Update AKASH_BACKEND constant with current Akash ingress URL
