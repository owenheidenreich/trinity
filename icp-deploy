#!/bin/bash
# ============================================================================
# Trinity ICP Deployment Script
# ============================================================================
# Builds and deploys both ICP canisters in the correct order:
# 1. Backend canister (Rust) - HTTPS Outcalls to Akash
# 2. Frontend canister (Vite assets) - User interface
#
# Usage:
#   ./icp-deploy              # Deploy both canisters
#   ./icp-deploy frontend     # Deploy frontend only
#   ./icp-deploy backend      # Deploy backend only
#   ./icp-deploy --local      # Deploy to local replica (testing)
# ============================================================================

set -e  # Exit on any error

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# Get script directory and project paths
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ICP_DIR="$SCRIPT_DIR/trinity-icp"

# Parse arguments
NETWORK="ic"  # Default to mainnet
TARGET="all"  # Default to both canisters

for arg in "$@"; do
    case $arg in
        --local)
            NETWORK="local"
            ;;
        frontend)
            TARGET="frontend"
            ;;
        backend)
            TARGET="backend"
            ;;
        --help|-h)
            echo "Usage: ./icp-deploy [frontend|backend] [--local]"
            echo ""
            echo "Options:"
            echo "  frontend    Deploy frontend canister only"
            echo "  backend     Deploy backend canister only"
            echo "  --local     Deploy to local replica instead of mainnet"
            echo "  --help      Show this help message"
            exit 0
            ;;
    esac
done

echo -e "${BLUE}============================================${NC}"
echo -e "${BLUE}  Trinity ICP Deployment${NC}"
echo -e "${BLUE}============================================${NC}"
echo -e "Network: ${YELLOW}$NETWORK${NC}"
echo -e "Target:  ${YELLOW}$TARGET${NC}"
echo ""

# Verify we're in the right directory
if [ ! -d "$ICP_DIR" ]; then
    echo -e "${RED}Error: trinity-icp directory not found${NC}"
    echo "Run this script from the Trinity project root"
    exit 1
fi

cd "$ICP_DIR"

# Check dfx identity
echo -e "${BLUE}Checking dfx identity...${NC}"
IDENTITY=$(dfx identity whoami)
PRINCIPAL=$(dfx identity get-principal)
echo -e "Identity:  ${GREEN}$IDENTITY${NC}"
echo -e "Principal: ${GREEN}$PRINCIPAL${NC}"
echo ""

# ============================================================================
# BACKEND CANISTER (Rust)
# ============================================================================
deploy_backend() {
    echo -e "${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    echo -e "${BLUE}  Step 1: Building Backend Canister (Rust)${NC}"
    echo -e "${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    
    if [ "$NETWORK" = "ic" ]; then
        dfx deploy trinity_backend --network ic --yes
    else
        dfx deploy trinity_backend --yes
    fi
    
    echo -e "${GREEN}✓ Backend canister deployed${NC}"
    echo ""
}

# ============================================================================
# FRONTEND CANISTER (Vite + Assets)
# ============================================================================
deploy_frontend() {
    echo -e "${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    echo -e "${BLUE}  Step 2: Building Frontend (Vite)${NC}"
    echo -e "${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    
    # Build frontend assets
    npm run build
    
    echo -e "${BLUE}  Deploying Frontend Canister...${NC}"
    
    if [ "$NETWORK" = "ic" ]; then
        dfx deploy trinity_frontend --network ic --yes
    else
        dfx deploy trinity_frontend --yes
    fi
    
    echo -e "${GREEN}✓ Frontend canister deployed${NC}"
    echo ""
}

# ============================================================================
# VERIFICATION
# ============================================================================
verify_deployment() {
    echo -e "${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    echo -e "${BLUE}  Verification${NC}"
    echo -e "${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    
    if [ "$NETWORK" = "ic" ]; then
        # Verify backend
        if [ "$TARGET" = "all" ] || [ "$TARGET" = "backend" ]; then
            echo -e "${BLUE}Testing backend canister health check...${NC}"
            HEALTH=$(dfx canister --network ic call trinity_backend health 2>&1)
            if echo "$HEALTH" | grep -q "healthy"; then
                echo -e "${GREEN}✓ Backend health check passed${NC}"
            else
                echo -e "${YELLOW}⚠ Backend health check returned:${NC}"
                echo "$HEALTH" | head -5
            fi
        fi
        
        echo ""
        echo -e "${GREEN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
        echo -e "${GREEN}  Deployment Complete!${NC}"
        echo -e "${GREEN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
        echo ""
        echo -e "Frontend: ${BLUE}https://zc67k-kiaaa-aaaal-qtmiq-cai.icp0.io/${NC}"
        echo -e "Backend:  ${BLUE}https://a4gq6-oaaaa-aaaab-qaa4q-cai.raw.icp0.io/?id=au5zq-2qaaa-aaaal-qtowa-cai${NC}"
    else
        echo -e "${GREEN}Local deployment complete${NC}"
    fi
}

# ============================================================================
# MAIN EXECUTION
# ============================================================================

case $TARGET in
    backend)
        deploy_backend
        ;;
    frontend)
        deploy_frontend
        ;;
    all)
        deploy_backend
        deploy_frontend
        ;;
esac

verify_deployment

echo ""
echo -e "${GREEN}Done!${NC}"
